# ===========================================================================
# SZABLON ZMIENNYCH ŚRODOWISKOWYCH
# ===========================================================================
# Skopiuj ten plik jako `.env` i uzupełnij prawdziwymi wartościami.
# NIGDY nie commituj pliku `.env` do repozytorium.
# ===========================================================================

# ── Baza danych (PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL="postgresql://uzytkownik:haslo@host:5432/nazwa_bazy?sslmode=require"

# ── NextAuth ───────────────────────────────────────────────────────────────
# Wygeneruj losowy sekret komendą:  openssl rand -base64 32
# Zmiana tej wartości unieważnia wszystkie aktywne sesje użytkowników.
NEXTAUTH_SECRET="wygeneruj_losowy_ciag_min_32_znaki"
AUTH_SECRET="ta_sama_wartosc_co_NEXTAUTH_SECRET"

# Pełny adres sklepu wraz z protokołem, bez ukośnika na końcu.
NEXTAUTH_URL="https://twoj-sklep.pl"
NEXT_PUBLIC_APP_URL="https://twoj-sklep.pl"
AUTH_TRUST_HOST="true"

# ── Cloudinary (zdjęcia produktów) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Resend (e-maile transakcyjne) ──────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Sklep <noreply@twoja-domena.pl>"

# ── Przelewy24 ─────────────────────────────────────────────────────────────
# Dane z panelu P24: Moje dane -> Konfiguracja / Klucze API
P24_MERCHANT_ID=""
P24_POS_ID=""
P24_CRC=""
P24_API_KEY=""
# "true" = środowisko testowe sandbox.przelewy24.pl
P24_SANDBOX="true"

# ── Furgonetka (webhook przesyłek) ─────────────────────────────────────────
# Losowy sekret o długości MINIMUM 24 znaków – krótsze są odrzucane przez API.
# Wygeneruj:  openssl rand -hex 32
FURGONETKA_WEBHOOK_TOKEN=""
